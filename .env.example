# ============================================================
# MindCare Clinic — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# --------------- WhatsApp (CallMeBot) ----------------------
# The clinic owner's WhatsApp number WITH country code, NO + sign
# Example: 966512345678 (Saudi Arabia)
VITE_CALLMEBOT_PHONE=966512345678

# CallMeBot API key (received after WhatsApp registration)
# How to get it:
#   1. Save +34 644 59 77 39 in WhatsApp as "CallMeBot"
#   2. Send: "I allow callmebot to send me messages"
#   3. You receive your API key via WhatsApp reply
VITE_CALLMEBOT_APIKEY=your_callmebot_api_key_here

# Set to 'true' to enable real WhatsApp notifications in production
# In dev mode (npm run dev), keep this 'false' — calls will be mocked
VITE_WHATSAPP_ENABLED=false
