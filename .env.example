# ============================================================
# MindCare Clinic — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
#
# SECURITY NOTE:
# Provider credentials (CALLMEBOT_PHONE, CALLMEBOT_APIKEY) are
# SERVER-ONLY variables read by `/api/booking/whatsapp`.
# Do NOT prefix them with `VITE_`, as `VITE_` variables are bundled
# into client-side browser code.

# --------------- Server-Side WhatsApp (CallMeBot) -----------
# The clinic owner's WhatsApp number WITH country code, NO + sign or spaces
# Example: 966512345678 (Saudi Arabia)
CALLMEBOT_PHONE=966512345678

# CallMeBot API key (received after WhatsApp activation)
# How to obtain or recover your key:
#   1. Save the active CallMeBot WhatsApp contact number from https://www.callmebot.com/blog/free-api-whatsapp-messages/
#      (historically +34 644 59 77 39) in WhatsApp contacts as "CallMeBot"
#   2. Send via WhatsApp: "I allow callmebot to send me messages"
#      (or send "Recover APIKey" if you previously registered and lost your key)
#   3. Put the returned numeric API key below:
CALLMEBOT_APIKEY=your_callmebot_api_key_here

# Set to 'true' to send real WhatsApp notifications via /api/booking/whatsapp
# Keep 'false' during normal development to run in simulated mock mode
WHATSAPP_ENABLED=false

# Optional: Explicitly force mock mode ('true' or 'false')
# By default, mock mode is active only in development when WHATSAPP_ENABLED=false
# MOCK_BOOKING=false

# Optional: Request timeout (ms) for server-to-CallMeBot requests (1000–30000, default 10000)
# CALLMEBOT_TIMEOUT_MS=10000

# --------------- Public Frontend Contact Info (Optional) ----
# Public clinic WhatsApp number displayed in the "Chat on WhatsApp" sidebar link (not a secret)
# VITE_CLINIC_WHATSAPP_NUMBER=966112345678
